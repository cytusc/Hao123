DATABASE_URL=postgres://hao123:replace-with-db-password@127.0.0.1:5432/hao123?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
COOKIE_SECURE=false
STATIC_DIR=../dist
# 仅用于首次创建管理员；不会重置已有管理员的密码。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# 邮件服务可选；未配置时账号可注册，验证和找回邮件无法投递。
# 启用 SMTP 时必须配置公共页面地址与发件人（不信任请求 Host）。
APP_PUBLIC_URL=https://navigation.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM="好123 <no-reply@example.com>"
SMTP_USERNAME=
SMTP_PASSWORD=
# 465 使用隐式 TLS，其他端口要求 STARTTLS。
# 仅本机测试收件箱可以设置 true；生产环境保持 false。
SMTP_ALLOW_INSECURE=false
